# Copia este fichero como ".env" (en la misma carpeta que generar_app.py) y rellena tus claves.
# El script las carga automáticamente al arrancar gracias a python-dotenv.
# No subas nunca el .env real a un repositorio. Solo necesitas rellenar la clave de la
# plataforma que vayas a usar (puedes dejar la otra vacía o sin esa línea).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Qué plataforma usar si no pasas --provider (anthropic | openai)
AI_PROVIDER=anthropic

# Modelo por defecto de cada plataforma si no usas --model (ver: python generar_app.py --list-models)
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-6-luna
