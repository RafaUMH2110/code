    {
      "label": "Limpiar build/ y dist/ (ambas apps)",
      "type": "shell",
      "command": "rm -rf app_tk/build app_tk/dist app_web/build app_web/dist app_pyside6/build app_pyside6/dist app_wx/build app_wx/dist app_pyobjc/build app_pyobjc/dist app_toga/build app_toga/dist",
