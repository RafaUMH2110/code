{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tkinter: ejecutar / depurar",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app_tk/notas_app.py",
      "cwd": "${workspaceFolder}/app_tk",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pywebview: ejecutar / depurar (con inspector web)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app_web/notas_web.py",
      "args": [
        "--debug"
      ],
      "cwd": "${workspaceFolder}/app_web",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "pywebview: ejecutar sin inspector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app_web/notas_web.py",
      "cwd": "${workspaceFolder}/app_web",
      "console": "integratedTerminal"
    },
    {
      "name": "PySide6: ejecutar / depurar",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app_pyside6/notas_pyside6.py",
      "cwd": "${workspaceFolder}/app_pyside6",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "wxPython: ejecutar / depurar",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app_wx/notas_wx.py",
      "cwd": "${workspaceFolder}/app_wx",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "PyObjC: ejecutar / depurar",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app_pyobjc/notas_pyobjc.py",
      "cwd": "${workspaceFolder}/app_pyobjc",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Toga: ejecutar / depurar",
      "type": "debugpy",
      "request": "launch",
      "module": "notas_rapidas_toga",
      "cwd": "${workspaceFolder}/app_toga/src",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Fichero actual",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal"
    }
  ]
}
