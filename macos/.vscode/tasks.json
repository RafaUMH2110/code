{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "0. Crear entorno de desarrollo (.venv)",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install --upgrade pip py2app pywebview",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },

    {
      "label": "Construir .app Tkinter (independiente)",
      "type": "shell",
      "command": "./construir_app.sh",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_tk" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Construir .app pywebview (independiente)",
      "type": "shell",
      "command": "./construir_app_web.sh",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_web" },
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },

    {
      "label": "Alias .app Tkinter (desarrollo rápido)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python setup.py py2app -A",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_tk" },
      "problemMatcher": []
    },
    {
      "label": "Alias .app pywebview (desarrollo rápido)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python setup_web.py py2app -A",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_web" },
      "problemMatcher": []
    },

    {
      "label": "Abrir .app Tkinter",
      "type": "shell",
      "command": "open 'dist/Notas Rápidas.app'",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_tk" },
      "problemMatcher": []
    },
    {
      "label": "Abrir .app pywebview",
      "type": "shell",
      "command": "open 'dist/Notas Rápidas Web.app'",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_web" },
      "problemMatcher": []
    },

    {
      "label": "Ejecutar .app Tkinter con salida en terminal",
      "type": "shell",
      "command": "'dist/Notas Rápidas.app/Contents/MacOS/Notas Rápidas'",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_tk" },
      "problemMatcher": []
    },
    {
      "label": "Ejecutar .app pywebview con salida en terminal",
      "type": "shell",
      "command": "'dist/Notas Rápidas Web.app/Contents/MacOS/Notas Rápidas Web'",
      "options": { "cwd": "${workspaceFolder}/notas-rapidas/app_web" },
      "problemMatcher": []
    },

    {
      "label": "Ver log de la app Tkinter",
      "type": "shell",
      "command": "tail -n 50 -f ~/Library/Logs/NotasRapidas/app.log",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Ver log de la app pywebview",
      "type": "shell",
      "command": "tail -n 50 -f ~/Library/Logs/NotasRapidasWeb/app.log",
      "isBackground": true,
      "problemMatcher": []
    },

    {
      "label": "Limpiar build/ y dist/ (ambas apps)",
      "type": "shell",
      "command": "rm -rf notas-rapidas/app_tk/build notas-rapidas/app_tk/dist notas-rapidas/app_web/build notas-rapidas/app_web/dist",
      "problemMatcher": []
    }
  ]
}
