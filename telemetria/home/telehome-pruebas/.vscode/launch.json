{
  // Configuraciones de ejecución/depuración (F5 o panel «Ejecutar y depurar»).
  // Requieren la extensión «Python Debugger» (ms-python.debugpy) y el intérprete de .venv.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pruebas: estado de todos",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["estado"]
    },
    {
      "name": "Pruebas: estado (simulado)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["--simular", "estado"]
    },
    {
      "name": "Pruebas: encender…",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["encender", "${input:enchufe}"]
    },
    {
      "name": "Pruebas: apagar…",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["apagar", "${input:enchufe}"]
    },
    {
      "name": "Pruebas: conmutar…",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["conmutar", "${input:enchufe}"]
    },
    {
      "name": "Pruebas: vigilar (10 lecturas a CSV)",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["vigilar", "todos", "--veces", "10", "--csv", "${workspaceFolder}/lecturas.csv"]
    },
    {
      "name": "Pruebas: datos crudos (dps)…",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["dps", "${input:enchufe}"]
    },
    {
      "name": "Pruebas: dispositivos de la nube",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": ["nube-dispositivos"]
    },
    {
      "name": "Pruebas: orden libre…",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/telehome-pruebas.py",
      "args": "${input:argumentos}"
    }
  ],
  "inputs": [
    {
      "id": "enchufe", "type": "promptString",
      "description": "Enchufe: nombre, posición (1-7), Device ID o «todos»", "default": "1"
    },
    {
      "id": "argumentos", "type": "promptString",
      "description": "Argumentos (p. ej.: --json estado 1 2   ·   vigilar Nevera -i 60 -n 5)", "default": "estado"
    }
  ]
}
