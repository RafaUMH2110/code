{
  // F5: abre la app en Chrome contra el servidor de desarrollo (tarea «Servir»).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Abrir en Chrome (servir.py en el puerto 8080)",
      "type": "chrome", "request": "launch",
      "url": "http://127.0.0.1:8080/",
      "preLaunchTask": "Servir (servir.py)",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Python: servir.py",
      "type": "debugpy", "request": "launch", "console": "integratedTerminal",
      "program": "${workspaceFolder}/servir.py",
      "args": ["--api", "http://127.0.0.1:8765"]
    }
  ]
}
