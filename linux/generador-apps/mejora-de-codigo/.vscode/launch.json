{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Generar app (interactivo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generar_app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Listar modelos disponibles",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generar_app.py",
      "args": ["--list-models"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
